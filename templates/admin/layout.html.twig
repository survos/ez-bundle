{% extends '@!EasyAdmin/layout.html.twig' %}

{% block configured_stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('@survos/ez-bundle/menu.css') }}">
{% endblock %}

{% block wrapper %}
    {% if ez_locale_placement() == 'header' %}
        {% set settings_dropdown = include('@SurvosEz/admin/appearance.html.twig') %}
    {% endif %}
    {{ parent() }}
{% endblock %}

{% block header_custom_menu_wrapper %}
    {{ include('@SurvosEz/admin/header_slots.html.twig') }}
    {{ parent() }}
{% endblock %}

{% block responsive_header %}
    {{ parent() }}
    {{ include('@SurvosEz/admin/header_slots.html.twig') }}
{% endblock %}

{% block flash_messages %}
    {{ parent() }}
    {{ ez_menu(BANNER) }}
{% endblock %}

{% block content_header_wrapper %}
    {{ ez_menu(BREADCRUMB) }}
    {{ ez_menu(PAGE_NAV) }}
    {{ parent() }}
{% endblock %}

{% block page_actions_wrapper %}
    {{ parent() }}
    {{ ez_menu(PAGE_ACTIONS) }}
{% endblock %}

{% block main_menu_wrapper %}
    {{ parent() }}
    {{ ez_menu(SIDEBAR, {}, {vertical: true}) }}
{% endblock %}

{% block content_footer_wrapper %}
    {{ parent() }}
    {{ ez_menu(FOOTER) }}
    {{ ez_menu(FOOTER_END) }}
{% endblock %}
